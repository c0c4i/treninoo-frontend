- const screens = { treno: 'Cerca un treno', ricerca: 'Trova le soluzioni', stazione: 'Arrivi e partenze', preferiti: 'I tuoi preferiti' }

mixin device(...names)
    .device-wrapper.mx-auto
        .device
            if names.length === 1
                .screen
                    img.screen-img(src=`assets/img/screen-${names[0]}.webp`, alt=screens[names[0]])
            else
                .screen.tab-content
                    each name, i in names
                        .tab-pane.fade(id=`screen-${name}`, role='tabpanel', class=i === 0 ? 'show active' : '')
                            img.screen-img(src=`assets/img/screen-${name}.webp`, alt=screens[name])

mixin badges
    a.me-lg-3.mb-4.mb-lg-0(href='https://play.google.com/store/apps/details?id=it.samuelebesoli.treninoo', target='_blank', rel='noopener')
        img.app-badge(src='assets/img/google-play-badge.svg', alt='Disponibile su Google Play')
    a(href='https://apps.apple.com/us/app/treninoo/id1574219058', target='_blank', rel='noopener')
        img.app-badge(src='assets/img/app-store-badge.svg', alt="Scarica su App Store")

//- a feature is also the tab that shows its screen on the phone
mixin feature(name, icon, title, active)
    button.feature-tab(type='button', role='tab', data-bs-toggle='tab', data-bs-target=`#screen-${name}`, aria-controls=`screen-${name}`, aria-selected=active ? 'true' : 'false', class=active ? 'active' : '')
        i.icon-feature.text-gradient.d-block.mb-3(class='bi-' + icon)
        h3.font-alt= title
        p.text-muted.mb-0
            block

